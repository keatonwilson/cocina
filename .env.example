# cocina's Supabase project (local: values from `supabase status`)
COCINA_SUPABASE_URL=http://127.0.0.1:54321
COCINA_SUPABASE_SERVICE_KEY=   # pipeline only: it writes proposals
COCINA_SUPABASE_ANON_KEY=      # app/MCP: reads published rows only

# cartoTaco, read by `python -m cocina.seed` (anon key: read-only)
CARTOTACO_SUPABASE_URL=
CARTOTACO_ANON_KEY=

ANTHROPIC_API_KEY=             # research runs
COCINA_REVIEWER=               # name recorded on accepted/rejected proposals (default: OS user)

# app/MCP in production: the bearer token clients must send
MCP_TOKEN=
